{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "krea2-fixture-unet.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "fixture-text-encoder.safetensors",
      "type": "krea2",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "fixture-vae.safetensors"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{referenceImage}}"
    }
  },
  "5": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": ["4", 0],
      "upscale_method": "area",
      "megapixels": 0.140625,
      "resolution_steps": 16
    }
  },
  "6": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["10", 0],
      "lora_name": "krea2-fixture-reid.safetensors",
      "strength_model": 1.0
    }
  },
  "7": {
    "class_type": "Krea2OstrisEditModelPatch",
    "inputs": {
      "model": ["6", 0],
      "kv_cache": true
    }
  },
  "8": {
    "class_type": "TextEncodeKrea2OstrisEdit",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "image1": ["5", 0],
      "prompt": "{{prompt}}"
    }
  },
  "9": {
    "class_type": "SaveImageWebsocket",
    "inputs": {
      "images": ["16", 0]
    }
  },
  "10": {
    "class_type": "ModelAttentionBackend",
    "inputs": {
      "model": ["1", 0],
      "attention": "comfy kitchen attention"
    }
  },
  "11": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": {
      "conditioning": ["8", 0],
      "reference_latents_method": "index_timestep_zero"
    }
  },
  "12": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": {
      "conditioning": ["13", 0],
      "reference_latents_method": "index_timestep_zero"
    }
  },
  "13": {
    "class_type": "TextEncodeKrea2OstrisEdit",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "image1": ["5", 0],
      "prompt": ""
    }
  },
  "14": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": "{{count}}"
    }
  },
  "15": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["7", 0],
      "positive": ["11", 0],
      "negative": ["12", 0],
      "latent_image": ["14", 0],
      "seed": "{{seed}}",
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "16": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["15", 0],
      "vae": ["3", 0]
    }
  }
}
