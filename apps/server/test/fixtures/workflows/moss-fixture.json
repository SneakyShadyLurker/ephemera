{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "moss-fixture-base.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "fixture-moss-text-encoder.safetensors",
      "type": "moss_image",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "fixture-moss-vae.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "{{prompt}}"
    }
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["4", 0]
    }
  },
  "6": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": "{{count}}"
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["10", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0],
      "seed": "{{seed}}",
      "steps": 12,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["7", 0],
      "vae": ["3", 0]
    }
  },
  "9": {
    "class_type": "SaveImageWebsocket",
    "inputs": {
      "images": ["8", 0]
    }
  },
  "10": {
    "class_type": "ModelAttentionBackend",
    "inputs": {
      "model": ["11", 0],
      "attention": "comfy kitchen attention"
    }
  },
  "11": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "moss-fixture-lora.safetensors",
      "strength_model": 1.0
    }
  }
}
